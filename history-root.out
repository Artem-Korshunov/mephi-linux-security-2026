    1  whoami
    2  exit
    3  sudo usermod -aG sudo artem
    4  su
    5  exit
    6  sudo usermod -aG sudo artem
    7  groups artem
    8  exit
    9  mkdir -p /home/user1/mephi-linux-security-2026
   10  cp /etc/passwd /home/user1/mephi-linux-security-2026/passwd.out
   11  cp /etc/group /home/user1/mephi-linux-security-2026/group.out
   12  cp /etc/sudoers /home/user1/mephi-linux-security-2026/sudoers.out
   13  cp /etc/sudoers.d/user1-time /home/user1/mephi-linux-security-2026/sudoers-user1-time.out
   14  cp /etc/shadow /home/user1/shadow.raw
   15  chmod 600 /home/user1/shadow.raw 
   16  awk -F: 'BEGIN { OFS=":" } { $2="[REDACTED]" } { print }' /etc/shadow > /home/user1/mephi-linux-security-2026/shadow.out
   17  cat /home/user1/mephi-linux-security-2026/shadow.out 
   18  stat /home/user1 > /home/user1/mephi-linux-security-2026/stat.out
   19  stat /home/user1/cat-suid >> /home/user1/mephi-linux-security-2026/stat.out 
   20  stat /home/user1/chown-cap >> /home/user1/mephi-linux-security-2026/stat.out 
   21  /usr/sbin/getcap /home/user1/cat-suid /home/user1/chown-cap > /home/user1/mephi-linux-security-2026/setuid-files.out
   22  cat /home/user1/mephi-linux-security-2026/setuid-files.out 
   23  find / -type f -perm -4000 -ls 2>/dev/null > /home/user1/mephi-linux-security-2026/setuid-files.out 
   24  ps -eo pid,ruid,euid,user,ruser,comm,args awk 'NR==1 || ($3==0 && $2>=1000)' /home/user1/mephi-linux-security-2026/processes.out
   25  ps -eo pid,ruid,euid,user,ruser,comm,args awk 'NR==1 || ($3==0 && $2>=1000)' /home/user1/mephi-linux-security-2026/processes.out
   26  ls -a
   27  cd /home/user1/
   28  ls -a
   29  cat processes.out 
   30  cp /home/user1/processes.out  /home/user1/mephi-linux-security-2026/processes.out
   31  history > /home/user1/mephi-linux-security-2026/history-root.out
